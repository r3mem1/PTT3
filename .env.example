# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env никогда не должен попадать в git — он уже в .gitignore.

# Токен бота, который выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ключ с https://www.pexels.com/api/ (бесплатно, для поиска картинок к слайдам)
PEXELS_API_KEY=

# Необязательные настройки
# OPENROUTER_MODEL=openai/gpt-4o-mini
# SLIDES_COUNT=6
# LOG_LEVEL=INFO
# TOPIC_MIN_LEN=3
# TOPIC_MAX_LEN=300
